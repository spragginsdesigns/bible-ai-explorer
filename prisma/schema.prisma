generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                    String                 @id // Clerk userId used directly
  email                 String?
  name                  String?
  // When false, memories are neither injected into prompts nor extracted from
  // chats (Settings → Memory toggle). Existing UserMemory rows are kept.
  memoryEnabled         Boolean                @default(true)
  // When false, the webSearch (Tavily) tool is not offered to the model
  // (Settings → Web Search toggle). Server-enforced in the chat routes.
  webSearchEnabled      Boolean                @default(true)
  // Subscription tier: "free" | "pro". SureWord Pro gates the paid benefits
  // (currently Listen, the spoken devotional). Read through
  // src/lib/entitlements.ts, never directly - the PRO_USER_IDS allowlist
  // grants Pro without a database write.
  plan                  String                 @default("free")
  // Last model/effort the user picked in the chat picker; validated against
  // the registry in src/lib/ai/models.ts on every use, so a stale id here
  // falls back to the default rather than erroring.
  defaultModelId        String?
  defaultEffort         String?
  // Last run options the user picked beside the model: "standard" | "fast",
  // "low" | "medium" | "high", "standard" | "pro". Nullable and unconstrained
  // like defaultEffort above; validated on read (isSpeed / isVerbosity /
  // isReasoningMode), and clamped again to what the chosen model accepts, so a
  // value left over from another model is ignored rather than sent.
  defaultSpeed          String?
  defaultVerbosity      String?
  defaultMode           String?
  // Account preferences the clients sync through /api/preferences. They live
  // on the account rather than on the device because a reader who switched to
  // NKJV on their phone means it on the web too; theme and font size stay
  // device settings. Validated on read (src/lib/preferences-contract.ts), so a
  // value from a newer build degrades to the default instead of erroring.
  translation           String                 @default("KJV") // "KJV" | "NKJV"
  parchment             Boolean                @default(true)
  listenRate            Float                  @default(1) // one of 0.75, 1, 1.25, 1.5, 2
  createdAt             DateTime               @default(now())
  conversations         Conversation[]
  notes                 Note[]
  folders               Folder[]
  tags                  Tag[]
  memories              UserMemory[]
  attachments           ChatAttachment[]
  providerCredentials   ProviderCredential[]
  pushTokens            PushToken[]
  readingEvents         ReadingEvent[]
  highlights            VerseHighlight[]
  versesOfDay           VerseOfDay[]
  suggestedQuestionSets SuggestedQuestionSet[]
  readingPlans          ReadingPlan[]
  church                UserChurch?
}

// The user's home church (Settings → My church), picked from Google Places.
// One per user; re-picking replaces it. Injected into the chat system prompt
// beside memories (src/lib/church.ts) so the assistant knows the congregation
// the user belongs to. `mission`/`about` are extracted from the church's own
// public website and are treated as untrusted text at injection time.
model UserChurch {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId       String // Google Places (New) place id
  name          String
  address       String
  phone         String?
  website       String?
  mapsUrl       String?
  // Logo/photo shown on the card. `photoSource` says where it came from:
  // "website" (favicon/og:image/apple-touch-icon URL, stored directly) or
  // "places" (served through GET /api/church/photo so the key stays server-side).
  photoUrl      String?
  photoSource   String?
  photoName     String? // Places photo resource name when photoSource = "places"
  mission       String?  @db.Text // ≤ 1500 chars, extracted mission/vision statement
  about         String?  @db.Text // ≤ 600 chars, one-paragraph description
  missionSource String? // URL the mission text came from
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  MOONSHOT
  OPENROUTER
}

/// A user's own API key for an AI provider (BYOK). The key is encrypted at
/// rest with AES-256-GCM under CREDENTIAL_ENCRYPTION_KEY and is never
/// returned to clients after entry — only last4 is.
model ProviderCredential {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  provider     AiProvider
  encryptedKey String     @db.Text
  last4        String
  validatedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

/// Maps a verified email to the Clerk user id it had on the DEVELOPMENT Clerk
/// instance, so accounts survive the move to the production instance.
///
/// Clerk dev and prod instances have completely separate user pools, and
/// User.id IS the Clerk id. Without this table, the 40 accounts that existed
/// before the switch would each be handed a brand new id on their first
/// production sign-in, orphaning every conversation, note and memory they own.
/// On first sign-in we match by verified email and re-key User.id, which
/// cascades to every child row (all FKs to User are ON UPDATE CASCADE).
model LegacyClerkAccount {
  email           String    @id
  legacyUserId    String    @unique
  /// Set once the mapping has been consumed, so a re-key can never run twice.
  claimedAt       DateTime?
  claimedByUserId String?
  createdAt       DateTime  @default(now())
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  category  String   @default("general") // profile | prayer | study | preference | general
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Message {
  id             String           @id @default(cuid())
  role           String // "user" | "assistant"
  content        String           @db.Text
  metadata       Json? // { tavilyResults, retrievedVerses, averageSimilarity, followUps }
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  attachments    ChatAttachment[]

  @@index([conversationId])
}

enum ChatAttachmentStatus {
  PENDING
  READY
}

model ChatAttachment {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messageId String?
  message   Message?             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pathname  String               @unique
  filename  String
  mediaType String
  size      Int
  etag      String?
  status    ChatAttachmentStatus @default(PENDING)
  createdAt DateTime             @default(now())
  readyAt   DateTime?

  @@index([userId])
  @@index([messageId])
  @@index([status, createdAt])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     Note[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  color     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     NoteTag[]
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Note {
  id            String          @id @default(cuid())
  title         String
  content       String          @db.Text // Tiptap JSON
  htmlContent   String          @db.Text
  plainText     String          @db.Text
  /// Extra names a [[wikilink]] may resolve to besides the title. Titles are
  /// not unique per user, so resolution is case-insensitive over title +
  /// aliases and the most recently updated note wins a collision.
  aliases       String[]        @default([])
  /// Free-form note metadata (Obsidian-style properties): a flat object of
  /// string/number/boolean/string[] values. Kept out of list payloads.
  properties    Json?
  folderId      String?
  folder        Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags          NoteTag[]
  aiMessages    NoteAIMessage[]
  embeddings    NoteEmbedding[]
  outgoingLinks NoteLink[]      @relation("NoteLinkSource")
  incomingLinks NoteLink[]      @relation("NoteLinkTarget")
  isPinned      Boolean         @default(false)
  wordCount     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([folderId])
}

/// One [[wikilink]] parsed out of a note's plainText, which is the only body
/// field every client writes identically. Rows are rebuilt by
/// src/lib/note-links.ts on every note write, so they are derived data: a row
/// with targetNoteId null is a link to a note that does not exist yet, and it
/// resolves itself when a note claiming that title or alias is written.
model NoteLink {
  id           String   @id @default(cuid())
  sourceNoteId String
  source       Note     @relation("NoteLinkSource", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNoteId String?
  target       Note?    @relation("NoteLinkTarget", fields: [targetNoteId], references: [id], onDelete: SetNull)
  targetKey    String // lowercased trimmed target, for dedupe and resolution
  targetTitle  String // raw target text as the user typed it
  snippet      String   @db.Text // surrounding plainText, for backlink previews
  userId       String
  createdAt    DateTime @default(now())

  @@unique([sourceNoteId, targetKey])
  @@index([targetNoteId])
  @@index([userId, targetKey])
}

/// pgvector index of KJV verse embeddings (text-embedding-3-large, 3072 dims
/// as halfvec). Populated by scripts/backfill-verse-embeddings.mjs; queried
/// with raw SQL in src/lib/scripture-search.ts. The HNSW index lives only in
/// the migration SQL - Prisma cannot express it.
model VerseEmbedding {
  book      Int
  chapter   Int
  verse     Int
  embedding Unsupported("halfvec(3072)")

  @@id([book, chapter, verse])
}

/// pgvector index of the user's note chunks for semantic note search.
/// Kept in sync by src/lib/note-embeddings.ts on every note write; rows
/// disappear with their note via the FK cascade.
model NoteEmbedding {
  noteId    String
  chunk     Int
  userId    String
  content   String                       @db.Text
  embedding Unsupported("halfvec(3072)")
  note      Note                         @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, chunk])
  @@index([userId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model NoteAIMessage {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String   @db.Text
  metadata  Json? // { parts: UIMessagePart[] }
  createdAt DateTime @default(now())

  @@index([noteId])
}

/// Expo push token registered by the mobile app, with the delivery preference
/// the hourly verse-of-day cron matches against (send when the token's local
/// hour equals notifyHour).
model PushToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique // Expo push token
  platform    String // "ios" | "android"
  timezone    String // e.g. "America/Chicago"
  notifyHour  Int      @default(8) // local hour, 0-23
  enabled     Boolean  @default(true) // verse-of-the-day pushes for this device
  /// "Your answer is ready" push when a chat answer finishes after the client
  /// disconnected. Independent of `enabled` so turning off the morning verse
  /// does not silence chat replies.
  chatReplies Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One chapter read, recorded by the readers after the chapter has been on
/// screen a few seconds. Powers verse-of-the-day personalization.
model ReadingEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        String // e.g. "John"
  chapter     Int
  translation String   @default("KJV")
  readAt      DateTime @default(now())

  @@index([userId, readAt])
}

/// A user's colored highlight on a single verse. Book is the canonical
/// order int (1-66); one highlight per verse per translation.
model VerseHighlight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation String   @default("KJV")
  book        Int // canonical order, 1-66
  chapter     Int
  verse       Int
  color       String // "#RRGGBB"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, translation, book, chapter, verse])
  @@index([userId, translation, book, chapter])
}

/// The verse the cron picked and pushed to a user, kept both as history and as
/// the exclusion list so recent picks are not repeated.
model VerseOfDay {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    String
  chapter Int
  verse   Int
  text    String
  reason  String // one-line AI rationale, shown in the notification body
  sentAt  DateTime @default(now())

  // "Pick Up Your Cross" guided-day content (nullable: rows from before the
  // guide existed, and fallback picks, may carry the verse alone).
  whyToday    String? // why this verse today, grounded in the user's real activity
  application String? // personal application, second person
  studyPath   String? // JSON array of { book, chapter, focus }
  question    String? // one question to carry through the day

  // How the personalized day was selected. These stay nullable because rows
  // created before selection provenance existed cannot be labelled honestly.
  primaryTheme      String? // human-readable theme, e.g. "speech that gives grace"
  primaryThemeKey   String? // stable coarse key used by the three-day novelty guard
  themeTags         Json? // additional stable theme keys, never raw account content
  selectionMode     String? // "theme" | "focus" | "pinned" | "fallback"
  selectionReason   String?  @db.Text // concise rationale for choosing this direction
  selectionEvidence Json? // bounded source ids/summaries used by the selector
  selectorModel     String? // namespaced model id, e.g. "openai/gpt-5.6-sol"
  selectorEffort    String? // reasoning effort used for selection
  writerModel       String? // namespaced model id used to write the guided day
  writerEffort      String? // reasoning effort used for the guided-day prose
  isFallback        Boolean? // null = legacy/unknown; new writes always set true/false
  fallbackReason    String?  @db.Text

  // "Listen" - the spoken devotional for this day, generated with the day for
  // Pro users so it is waiting when they open Pick Up Your Cross.
  audioUrl         String? // canonical Vercel Blob URL; clients get a short-lived signed URL instead
  audioPathname    String? // blob path, the handle used to sign and to delete
  audioScript      String? // the narrated text, shown as "Read along"
  audioTitle       String? // short spoken-devotional title
  audioDurationSec Int? // estimated from the script's word count
  audioStatus      String? // "pending" | "ready" | "failed"
  audioGeneratedAt DateTime? // when the current attempt started; ages out a stuck "pending"

  @@index([userId, sentAt])
}

/// Tap-a-verse explanation cache, shared across every account. The prompt is
/// the verse alone (no memories, church or history), so one explanation is as
/// right for the next reader as for the first; a tap bills a model only the
/// first time anyone opens that verse. If the prompt ever takes user context,
/// this cache must become per-user or go. `promptVersion` is bumped with the
/// prompt wording so stale explanations age out; `textHash` covers the verse
/// text the client sent, so altered text under a real reference cannot poison
/// another reader's sheet.
model VerseInsight {
  id            String   @id @default(cuid())
  translation   String
  reference     String // as the client shows it, e.g. "Luke 1:5"
  textHash      String // sha256 of the whitespace-normalised verse text, truncated
  promptVersion Int
  text          String   @db.Text
  model         String? // namespaced model id that wrote it, e.g. "openai/gpt-5.6-luna"
  createdAt     DateTime @default(now())

  @@unique([translation, reference, textHash, promptVersion])
}

/// A day's personalized welcome-screen questions, generated once (by the
/// morning cron or the first app open of the day) and served from here so
/// opening the app never waits on a model call. Newest row inside the reuse
/// window wins; older rows are history.
model SuggestedQuestionSet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions String // JSON array of question strings
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A reading plan the user is following. Progress is NOT stored here: a day
/// counts as read when every chapter of it appears in that user's ReadingEvent
/// history since startDate (see src/lib/reading-plan-progress.ts).
///
/// One live plan per user, enforced in src/lib/reading-plans.ts (starting a plan
/// archives the previous one) rather than by a partial unique index, because
/// completed and archived plans stay here as history.
model ReadingPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  source      String // "preset" | "ai"
  presetKey   String? // set only when source = "preset"
  startDate   DateTime @default(now()) // day 1 of the plan begins here
  days        String   @db.Text // JSON: [{ day, readings: [{ book, chapter }], focus }]
  status      String   @default("active") // "active" | "completed" | "archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions ReadingPlanCompletion[]

  @@index([userId, status])
}

/// A day the user ticked by hand - the escape hatch for reading done outside
/// the app, where no ReadingEvent was ever recorded.
model ReadingPlanCompletion {
  id          String      @id @default(cuid())
  planId      String
  plan        ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  day         Int
  completedAt DateTime    @default(now())

  @@unique([planId, day])
}
