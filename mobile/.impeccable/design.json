  "narrative": {
    "northStar": "Approved companion and question grid",
    "overview": "The Android chat home uses warm charcoal, ivory text, restrained gold, and a friendly folded-page companion. The open-Bible day-star mark and Pirata One wordmark preserve SureWord's recognizable identity; readable Atkinson Hyperlegible carries questions and controls.\n\nThis record applies to the approved chat surface and its shared navigation geometry. It does not replace the existing visual system for Bible, Notes, Settings, web, or Apple clients. Global palettes, Scripture typography, and reader ink remain defined by src/theme/index.ts.",
    "keyCharacteristics": [
      "Friendly parchment companion with an unchanged face, folds, and chest day-star.",
      "Quiet tonal surfaces, restrained hairline gold borders, and readable body type.",
      "Responsive question grid above a stable docked composer."
    ],
    "rules": [
      {
        "name": "Chat Boundary",
        "body": "Resolve the sanctuary palette through chatColors for chat. Preserve global theme colors and reader ink elsewhere.",
        "section": "colors"
      },
      {
        "name": "Reading First",
        "body": "Use Pirata One only for the SureWord wordmark; questions and controls retain the shared readable body family.",
        "section": "typography"
      },
      {
        "name": "Shared Clearance",
        "body": "Derive reserved navigation space from TAB_BAR_HEIGHT and safe-area insets. Never substitute the item height for the whole bar.",
        "section": "layout"
      },
      {
        "name": "Quiet Motion",
        "body": "Keep the selected pose readable when animation stops. Disable companion movement for Reduce Motion, a screen reader, or a backgrounded app.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the folded-page companion, open-Bible day-star mark, and SureWord wordmark.",
      "Do keep every suggested question in server order, reveal additional questions, and allow question text to wrap.",
      "Do keep chat palette changes scoped to chat and reserve the shared navigation height."
    ],
    "donts": [
      "Don't apply this chat palette to reader ink or treat the surface as an app-wide redesign.",
      "Don't hide model selection, conversation history, settings, attachment, send, or stop callbacks behind a visual replacement.",
      "Don't treat fixture screenshots or a scoped visual approval as authenticated transport, device, or release proof."
    ]
  }
