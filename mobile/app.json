{
	"expo": {
		"name": "SureWord",
		"slug": "sureword",
		"version": "1.15.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"scheme": "sureword",
		"userInterfaceStyle": "automatic",
		"backgroundColor": "#0a0a0a",
		"newArchEnabled": true,
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"enabled": true,
			"checkAutomatically": "ON_LOAD",
			"fallbackToCacheTimeout": 0
		},
		"android": {
			"package": "com.spragginsdesigns.sureword",
			"versionCode": 8,
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#0a0a0a"
			},
			"softwareKeyboardLayoutMode": "resize",
			"permissions": ["POST_NOTIFICATIONS"]
		},
		"splash": {
			"image": "./assets/icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#0a0a0a"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-web-browser",
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow SureWord to attach photos to your AI conversations.",
					"cameraPermission": "Allow SureWord to take photos for your AI conversations.",
					"microphonePermission": false
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/icon.png",
					"imageWidth": 180,
					"resizeMode": "contain",
					"backgroundColor": "#0a0a0a"
				}
			],
			[
				"expo-notifications",
				{
					"color": "#0a0a0a"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"apiUrl": "https://sureword.app",
			"clerkPublishableKey": "pk_live_Y2xlcmsuc3VyZXdvcmQuYXBwJA"
		}
	}
}
