{
	"expo": {
		"name": "VerseMind",
		"slug": "versemind",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"scheme": "versemind",
		"userInterfaceStyle": "dark",
		"backgroundColor": "#0a0a0a",
		"newArchEnabled": true,
		"android": {
			"package": "com.spragginsdesigns.versemind",
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#0a0a0a"
			},
			"edgeToEdgeEnabled": true,
			"softwareKeyboardLayoutMode": "resize"
		},
		"splash": {
			"image": "./assets/icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#0a0a0a"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-web-browser",
			[
				"expo-splash-screen",
				{
					"image": "./assets/icon.png",
					"imageWidth": 180,
					"resizeMode": "contain",
					"backgroundColor": "#0a0a0a"
				}
			]
		],
		"experiments": {
			"typedRoutes": false
		},
		"extra": {
			"apiUrl": "https://bible-ai-explorer.vercel.app",
			"clerkPublishableKey": "pk_test_aGVscGZ1bC1qYXdmaXNoLTI4LmNsZXJrLmFjY291bnRzLmRldiQ"
		}
	}
}
