<?xml version="1.0" encoding="utf-8"?>
<!--
	Closed and heads-up content area (DecoratedCustomViewStyle). Android can
	give this as little as 48dp, so the mark is 40dp and each line is one line.
	The art is pre-rounded in the drawable; RemoteViews cannot clip corners.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:orientation="horizontal">

	<ImageView
		android:id="@+id/sureword_notification_mark"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="12dp"
		android:importantForAccessibility="no"
		android:scaleType="fitCenter" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/sureword_notification_title"
			style="@android:style/TextAppearance.Material.Notification.Title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1" />

		<TextView
			android:id="@+id/sureword_notification_text"
			style="@android:style/TextAppearance.Material.Notification"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="1" />
	</LinearLayout>
</LinearLayout>
