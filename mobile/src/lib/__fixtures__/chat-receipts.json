{
	"description": "Receipts contract fixture (docs/FEATURES.md, Receipts). Shared by tests/chat-receipts.test.mjs and mobile/src/lib/receipts.test.ts; keep mobile/src/lib/__fixtures__/chat-receipts.json identical. Part shapes mirror the persisted Message.metadata.parts the tools write.",
	"cases": [
		{
			"name": "addToNote that created a note",
			"parts": [
				{ "type": "tool-addToNote", "toolCallId": "call_note_created", "state": "output-available", "input": { "markdown": "## Grace", "title": "Romans study" }, "output": { "noteId": "note_1", "noteTitle": "Romans study", "appendedHtml": "<h2>Grace</h2>", "created": true, "matchedExisting": false } }
			],
			"expected": [
				{ "id": "call_note_created", "kind": "note", "label": "Saved to Romans study", "target": { "screen": "note", "noteId": "note_1" } }
			]
		},
		{
			"name": "addToNote that appended to a named note (legacy row without matchedExisting)",
			"parts": [
				{ "type": "tool-addToNote", "toolCallId": "call_note_appended", "state": "output-available", "input": { "markdown": "More", "noteId": "note_2" }, "output": { "noteId": "note_2", "noteTitle": "Prayer journal", "appendedHtml": "<p>More</p>", "created": false } }
			],
			"expected": [
				{ "id": "call_note_appended", "kind": "note", "label": "Added to Prayer journal", "target": { "screen": "note", "noteId": "note_2" } }
			]
		},
		{
			"name": "addToNote redirected into an existing note by title (matchedExisting)",
			"parts": [
				{ "type": "tool-addToNote", "toolCallId": "call_note_matched", "state": "output-available", "input": { "markdown": "Again", "title": "romans study" }, "output": { "noteId": "note_1", "noteTitle": "Romans study", "appendedHtml": "<p>Again</p>", "created": false, "matchedExisting": true } }
			],
			"expected": [
				{ "id": "call_note_matched", "kind": "note", "label": "Added to Romans study", "target": { "screen": "note", "noteId": "note_1" } }
			]
		},
		{
			"name": "addToNote that threw (output-error) leaves no receipt",
			"parts": [
				{ "type": "tool-addToNote", "toolCallId": "call_note_error", "state": "output-error", "rawInput": { "markdown": "", "title": "Empty" }, "errorText": "Nothing to add: the provided content was empty." }
			],
			"expected": []
		},
		{
			"name": "updateNote",
			"parts": [
				{ "type": "tool-updateNote", "toolCallId": "call_note_updated", "state": "output-available", "input": { "markdown": "# Rewritten", "noteId": "note_3" }, "output": { "noteId": "note_3", "noteTitle": "Sermon notes", "previousWordCount": 120, "wordCount": 140 } }
			],
			"expected": [
				{ "id": "call_note_updated", "kind": "note", "label": "Updated Sermon notes", "target": { "screen": "note", "noteId": "note_3" } }
			]
		},
		{
			"name": "saveMemory that saved one memory",
			"parts": [
				{ "type": "tool-saveMemory", "toolCallId": "call_mem_saved", "state": "output-available", "input": { "content": "Prefers the KJV", "category": "preference" }, "output": { "success": true, "created": true, "memory": { "id": "mem_1", "content": "Prefers the KJV", "category": "preference" } } }
			],
			"expected": [
				{ "id": "call_mem_saved", "kind": "memory", "label": "Remembered", "target": { "screen": "memories", "memoryId": "mem_1" }, "undo": { "type": "forgetMemory", "memoryId": "mem_1" } }
			]
		},
		{
			"name": "two memories saved in one turn (saveMemory saves one per call, so two calls)",
			"parts": [
				{ "type": "tool-saveMemory", "toolCallId": "call_mem_a", "state": "output-available", "input": { "content": "Fact A", "category": "personal" }, "output": { "success": true, "created": true, "memory": { "id": "mem_a", "content": "Fact A", "category": "personal" } } },
				{ "type": "text", "text": "I will remember both." },
				{ "type": "tool-saveMemory", "toolCallId": "call_mem_b", "state": "output-available", "input": { "content": "Fact B", "category": "personal" }, "output": { "success": true, "created": false, "memory": { "id": "mem_b", "content": "Fact B", "category": "personal" } } }
			],
			"expected": [
				{ "id": "call_mem_a", "kind": "memory", "label": "Remembered", "target": { "screen": "memories", "memoryId": "mem_a" }, "undo": { "type": "forgetMemory", "memoryId": "mem_a" } },
				{ "id": "call_mem_b", "kind": "memory", "label": "Remembered", "target": { "screen": "memories", "memoryId": "mem_b" }, "undo": { "type": "forgetMemory", "memoryId": "mem_b" } }
			]
		},
		{
			"name": "saveMemory that failed (success false) leaves no receipt",
			"parts": [
				{ "type": "tool-saveMemory", "toolCallId": "call_mem_failed", "state": "output-available", "input": { "content": "Fact", "category": "personal" }, "output": { "success": false, "error": "Memory is full. Update a related memory or ask which memories the user wants removed." } }
			],
			"expected": []
		},
		{
			"name": "updateMemory",
			"parts": [
				{ "type": "tool-updateMemory", "toolCallId": "call_mem_updated", "state": "output-available", "input": { "id": "mem_1", "content": "Prefers the KJV only", "category": "preference" }, "output": { "success": true, "memory": { "id": "mem_1", "content": "Prefers the KJV only", "category": "preference" } } }
			],
			"expected": [
				{ "id": "call_mem_updated", "kind": "memory", "label": "Memory updated", "target": { "screen": "memories", "memoryId": "mem_1" } }
			]
		},
		{
			"name": "deleteMemories of three",
			"parts": [
				{ "type": "tool-deleteMemories", "toolCallId": "call_mem_deleted", "state": "output-available", "input": { "ids": ["mem_x", "mem_y", "mem_z"] }, "output": { "success": true, "deleted": 3 } }
			],
			"expected": [
				{ "id": "call_mem_deleted", "kind": "memory", "label": "Forgot 3 memories", "target": { "screen": "memories" } }
			]
		},
		{
			"name": "deleteMemories of one uses the singular",
			"parts": [
				{ "type": "tool-deleteMemories", "toolCallId": "call_mem_deleted_one", "state": "output-available", "input": { "ids": ["mem_x"] }, "output": { "success": true, "deleted": 1 } }
			],
			"expected": [
				{ "id": "call_mem_deleted_one", "kind": "memory", "label": "Forgot 1 memory", "target": { "screen": "memories" } }
			]
		},
		{
			"name": "setDailyCross",
			"parts": [
				{ "type": "tool-setDailyCross", "toolCallId": "call_cross", "state": "output-available", "input": { "focus": "patience" }, "output": { "reference": "James 1:4", "book": "James", "chapter": 1, "verse": 4, "text": "But let patience have her perfect work, that ye may be perfect and entire, wanting nothing.", "reason": "Patience", "whyToday": null, "application": null, "studyPath": [], "question": null, "previousReference": "Romans 5:3" } }
			],
			"expected": [
				{ "id": "call_cross", "kind": "cross", "label": "Today's cross: James 1:4", "target": { "screen": "cross" } }
			]
		},
		{
			"name": "startReadingPlan",
			"parts": [
				{ "type": "tool-startReadingPlan", "toolCallId": "call_plan_started", "state": "output-available", "input": { "confirmed": true, "presetKey": "gospels-30" }, "output": { "hasPlan": true, "title": "The Gospels in 30 Days", "description": "Walk with Jesus.", "status": "active", "dayCount": 30, "currentDay": 1, "todayDay": 1, "completedCount": 0, "percent": 0, "streak": 0, "today": { "day": 1, "reference": "Matthew 1-3", "focus": "The King is born", "done": false }, "next": [], "presets": [], "formatted": "" } }
			],
			"expected": [
				{ "id": "call_plan_started", "kind": "plan", "label": "Started The Gospels in 30 Days", "target": { "screen": "plan" } }
			]
		},
		{
			"name": "startReadingPlan refused without confirmation (output-error) leaves no receipt",
			"parts": [
				{ "type": "tool-startReadingPlan", "toolCallId": "call_plan_refused", "state": "output-error", "input": { "confirmed": false, "presetKey": "gospels-30" }, "errorText": "The user has not agreed to start this plan yet." }
			],
			"expected": []
		},
		{
			"name": "markReadingPlanDay reads the day from the call input",
			"parts": [
				{ "type": "tool-markReadingPlanDay", "toolCallId": "call_plan_marked", "state": "output-available", "input": { "day": 4 }, "output": { "hasPlan": true, "title": "The Gospels in 30 Days", "description": null, "status": "active", "dayCount": 30, "currentDay": 5, "todayDay": 5, "completedCount": 4, "percent": 13, "streak": 4, "today": null, "next": [], "presets": [], "formatted": "" } }
			],
			"expected": [
				{ "id": "call_plan_marked", "kind": "plan", "label": "Marked day 4", "target": { "screen": "plan" } }
			]
		},
		{
			"name": "markReadingPlanDay untick (done false) has no contract label and leaves no receipt",
			"parts": [
				{ "type": "tool-markReadingPlanDay", "toolCallId": "call_plan_unmarked", "state": "output-available", "input": { "day": 4, "done": false }, "output": { "hasPlan": true, "title": "The Gospels in 30 Days", "description": null, "status": "active", "dayCount": 30, "currentDay": 4, "todayDay": 5, "completedCount": 3, "percent": 10, "streak": 0, "today": null, "next": [], "presets": [], "formatted": "" } }
			],
			"expected": []
		},
		{
			"name": "highlightVerse in the default colour",
			"parts": [
				{ "type": "tool-highlightVerse", "toolCallId": "call_highlight_default", "state": "output-available", "input": { "reference": "Romans 8:28" }, "output": { "success": true, "reference": "Romans 8:28", "book": "Romans", "bookNumber": 45, "chapter": 8, "verse": 28, "endChapter": 8, "endVerse": 28, "verseCount": 1, "capped": false, "color": "#F5D76E", "colorName": "Yellow", "translation": "KJV" } }
			],
			"expected": [
				{ "id": "call_highlight_default", "kind": "highlight", "label": "Marked Romans 8:28", "target": { "screen": "chapter", "book": 45, "chapter": 8, "verse": 28, "translation": "KJV" } }
			]
		},
		{
			"name": "highlightVerse of a range in a named colour",
			"parts": [
				{ "type": "tool-highlightVerse", "toolCallId": "call_highlight_green", "state": "output-available", "input": { "reference": "Psalms 23:1-3", "color": "green" }, "output": { "success": true, "reference": "Psalms 23:1-3", "book": "Psalms", "bookNumber": 19, "chapter": 23, "verse": 1, "endChapter": 23, "endVerse": 3, "verseCount": 3, "capped": false, "color": "#27AE60", "colorName": "Green", "translation": "NKJV" } }
			],
			"expected": [
				{ "id": "call_highlight_green", "kind": "highlight", "label": "Marked Psalms 23:1-3 as Green", "target": { "screen": "chapter", "book": 19, "chapter": 23, "verse": 1, "translation": "NKJV" } }
			]
		},
		{
			"name": "organizeNote",
			"parts": [
				{ "type": "tool-organizeNote", "toolCallId": "call_note_organized", "state": "output-available", "input": { "noteId": "note_1", "folderName": "Romans", "tags": ["grace"] }, "output": { "success": true, "noteId": "note_1", "title": "Romans study", "folder": "Romans", "tags": ["grace"], "pinned": false, "createdFolder": false, "createdTags": [] } }
			],
			"expected": [
				{ "id": "call_note_organized", "kind": "note", "label": "Filed Romans study", "target": { "screen": "note", "noteId": "note_1" } }
			]
		},
		{
			"name": "data-memoryExtracted from passive extraction",
			"parts": [
				{ "type": "text", "text": "Amen." },
				{ "type": "data-memoryExtracted", "data": { "memoryId": "mem_passive", "content": "Attends a Baptist church" } }
			],
			"expected": [
				{ "id": "memoryExtracted:mem_passive", "kind": "memory", "label": "Remembered", "target": { "screen": "memories", "memoryId": "mem_passive" }, "undo": { "type": "forgetMemory", "memoryId": "mem_passive" } }
			]
		},
		{
			"name": "read tools, status narration and in-flight writes leave no receipt",
			"parts": [
				{ "type": "data-status", "id": "status", "data": { "label": "Thinking" } },
				{ "type": "tool-getPassage", "toolCallId": "call_read_passage", "state": "output-available", "input": { "reference": "John 3:16" }, "output": { "verses": [{ "reference": "John 3:16", "similarity": 1, "text": "For God so loved the world", "translation": "KJV" }] } },
				{ "type": "tool-findNotes", "toolCallId": "call_read_notes", "state": "output-available", "input": { "query": "grace" }, "output": { "notes": [{ "noteId": "note_1", "title": "Romans study", "preview": "", "updatedAt": "2026-09-12T00:00:00.000Z" }] } },
				{ "type": "tool-listMemories", "toolCallId": "call_read_memories", "state": "output-available", "input": {}, "output": { "success": true, "memories": [{ "id": "mem_1", "content": "Prefers the KJV", "category": "preference" }] } },
				{ "type": "tool-getDailyCross", "toolCallId": "call_read_cross", "state": "output-available", "input": {}, "output": { "reference": "James 1:4", "book": "James", "chapter": 1, "verse": 4, "text": "But let patience have her perfect work", "reason": "", "whyToday": null, "application": null, "studyPath": [], "question": null } },
				{ "type": "tool-saveMemory", "toolCallId": "call_mem_streaming", "state": "input-available", "input": { "content": "Fact", "category": "personal" } }
			],
			"expected": []
		},
		{
			"name": "a whole turn keeps part order across kinds",
			"parts": [
				{ "type": "tool-findNotes", "toolCallId": "call_turn_find", "state": "output-available", "input": { "query": "romans" }, "output": { "notes": [] } },
				{ "type": "tool-addToNote", "toolCallId": "call_turn_note", "state": "output-available", "input": { "markdown": "## Grace", "title": "Romans study" }, "output": { "noteId": "note_1", "noteTitle": "Romans study", "appendedHtml": "<h2>Grace</h2>", "created": true, "matchedExisting": false } },
				{ "type": "tool-highlightVerse", "toolCallId": "call_turn_highlight", "state": "output-available", "input": { "reference": "Romans 8:28" }, "output": { "success": true, "reference": "Romans 8:28", "book": "Romans", "bookNumber": 45, "chapter": 8, "verse": 28, "endChapter": 8, "endVerse": 28, "verseCount": 1, "capped": false, "color": "#F5D76E", "colorName": "Yellow", "translation": "KJV" } },
				{ "type": "text", "text": "Saved and marked." },
				{ "type": "data-memoryExtracted", "data": { "memoryId": "mem_turn", "content": "Studying Romans" } }
			],
			"expected": [
				{ "id": "call_turn_note", "kind": "note", "label": "Saved to Romans study", "target": { "screen": "note", "noteId": "note_1" } },
				{ "id": "call_turn_highlight", "kind": "highlight", "label": "Marked Romans 8:28", "target": { "screen": "chapter", "book": 45, "chapter": 8, "verse": 28, "translation": "KJV" } },
				{ "id": "memoryExtracted:mem_turn", "kind": "memory", "label": "Remembered", "target": { "screen": "memories", "memoryId": "mem_turn" }, "undo": { "type": "forgetMemory", "memoryId": "mem_turn" } }
			]
		}
	]
}
