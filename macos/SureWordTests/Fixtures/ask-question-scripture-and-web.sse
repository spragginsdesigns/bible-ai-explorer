data: {"type":"tool-output-available","toolCallId":"call_hjw36K3Ym3WRYomqD2wcOzWq","output":{"verses":[{"reference":"Luke 11:28","similarity":0.85962236,"text":"But he said, Yea rather, blessed are they that hear the word of God, and keep it."},{"reference":"Revelation 1:3","similarity":0.7932273,"text":"Blessed is he that readeth, and they that hear the words of this prophecy, and keep those things which are written therein: for the time is at hand."},{"reference":"Luke 8:15","similarity":0.7754879,"text":"But that on the good ground are they, which in an honest and good heart, having heard the word, keep it, and bring forth fruit with patience."}],"averageSimilarity":0.8094458533333334,"formatted":"Luke 11:28 KJV: \"But he said, Yea rather, blessed are they that hear the word of God, and keep it.\"\nRevelation 1:3 KJV: \"Blessed is he that readeth, and they that hear the words of this prophecy, and keep those things which are written therein: for the time is at hand.\"\nLuke 8:15 KJV: \"But that on the good ground are they, which in an honest and good heart, having heard the word, keep it, and bring forth fruit with patience.\""},"providerMetadata":{"openai":{"itemId":"fc_0498fa43a7356f86006a7c929791f0819eb3b9008c879cc295"}}}

data: {"type":"tool-output-available","toolCallId":"call_sPGdR5zz3eCxjByGd3gUUDMh","output":{"verses":[{"reference":"James 1:22","similarity":0.9030229,"text":"But be ye doers of the word, and not hearers only, deceiving your own selves."},{"reference":"James 1:23","similarity":0.7709296,"text":"For if any be a hearer of the word, and not a doer, he is like unto a man beholding his natural face in a glass:"},{"reference":"James 1:25","similarity":0.76674587,"text":"But whoso looketh into the perfect law of liberty, and continueth therein, he being not a forgetful hearer, but a doer of the work, this man shall be blessed in his deed."}],"averageSimilarity":0.8135661233333332,"formatted":"James 1:22 KJV: \"But be ye doers of the word, and not hearers only, deceiving your own selves.\"\nJames 1:23 KJV: \"For if any be a hearer of the word, and not a doer, he is like unto a man beholding his natural face in a glass:\"\nJames 1:25 KJV: \"But whoso looketh into the perfect law of liberty, and continueth therein, he being not a forgetful hearer, but a doer of the work, this man shall be blessed in his deed.\""},"providerMetadata":{"openai":{"itemId":"fc_0498fa43a7356f86006a7c929791e0819ea247acee4c435381"}}}

data: {"type":"tool-output-available","toolCallId":"call_N1WRklp9NBTXv7IEiMfQYsbm","output":{"verses":[{"reference":"John 5:39","similarity":0.8919509,"text":"Search the scriptures; for in them ye think ye have eternal life: and they are they which testify of me."},{"reference":"Luke 24:27","similarity":0.7564373,"text":"And beginning at Moses and all the prophets, he expounded unto them in all the scriptures the things concerning himself."},{"reference":"Luke 24:44","similarity":0.740253,"text":"And he said unto them, These are the words which I spake unto you, while I was yet with you, that all things must be fulfilled, which were written in the law of Moses, and in the prophets, and in the psalms, concerning me."}],"averageSimilarity":0.7962137333333333,"formatted":"John 5:39 KJV: \"Search the scriptures; for in them ye think ye have eternal life: and they are they which testify of me.\"\nLuke 24:27 KJV: \"And beginning at Moses and all the prophets, he expounded unto them in all the scriptures the things concerning himself.\"\nLuke 24:44 KJV: \"And he said unto them, These are the words which I spake unto you, while I was yet with you, that all things must be fulfilled, which were written in the law of Moses, and in the prophets, and in the psalms, concerning me.\""},"providerMetadata":{"openai":{"itemId":"fc_0498fa43a7356f86006a7c929791fc819eb3328cb15d426dcf"}}}

