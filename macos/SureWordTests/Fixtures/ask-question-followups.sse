data: {"type":"tool-output-available","toolCallId":"call_2YLIwNMxy9I25iTR7tJYCFTk","output":{"reference":"Romans 8:28-30","verses":[{"reference":"Romans 8:28","similarity":1,"text":"And we know that all things work together for good to them that love God, to them who are the called according to his purpose."},{"reference":"Romans 8:29","similarity":1,"text":"For whom he did foreknow, he also did predestinate to be conformed to the image of his Son, that he might be the firstborn among many brethren."},{"reference":"Romans 8:30","similarity":1,"text":"Moreover whom he did predestinate, them he also called: and whom he called, them he also justified: and whom he justified, them he also glorified."}],"formatted":"Romans 8:28 KJV: \"And we know that all things work together for good to them that love God, to them who are the called according to his purpose.\"\nRomans 8:29 KJV: \"For whom he did foreknow, he also did predestinate to be conformed to the image of his Son, that he might be the firstborn among many brethren.\"\nRomans 8:30 KJV: \"Moreover whom he did predestinate, them he also called: and whom he called, them he also justified: and whom he justified, them he also glorified.\""},"providerMetadata":{"openai":{"itemId":"fc_052d540f70896a8c006a7c92bd6d9081a397843414d21bad8f"}}}

